{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "verifier result",
  "type": "object",
  "required": ["status", "checks"],
  "properties": {
    "status": { "enum": ["pass", "fail"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "action", "expected", "actual", "passed"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "notes_for_memory": { "type": ["string", "null"] }
  }
}
