{
  "agents": {
    "claude_sonnet": {
      "provider": "claude",
      "model": "claude-sonnet-4-6",
      "dangerously_skip_permissions": true,
      "rate_limit_pattern": "(?i)(rate_?limit|429|quota|session limit|usage limit)"
    },
    "claude_opus": {
      "provider": "claude",
      "model": "claude-opus-4-8",
      "dangerously_skip_permissions": true,
      "rate_limit_pattern": "(?i)(rate_?limit|429|quota|session limit|usage limit)"
    },
    "codex_gpt5": {
      "provider": "codex",
      "model": "gpt-5.5",
      "effort": "medium",
      "rate_limit_pattern": "(?i)(429|usage limit reached|rate_?limit_exceeded|quota.*exceeded|usage limit)"
    }
  },
  "roles": {
    "ticket_planner": {"agents": ["claude_sonnet", "codex_gpt5"], "prompt": ".orquestalite/packs/development/4/prompts/ticket-planner.md", "result_path": ".orquestalite/results/ticket_planner.json", "timeout_seconds": 900},
    "coder": {"agents": ["codex_gpt5", "claude_sonnet"], "prompt": ".orquestalite/packs/development/4/prompts/coder.md", "result_path": ".orquestalite/results/coder.json", "timeout_seconds": 1800},
    "ticket_qa": {"agents": ["claude_sonnet", "codex_gpt5"], "prompt": ".orquestalite/packs/development/4/prompts/ticket-qa.md", "result_path": ".orquestalite/results/ticket_qa.json", "timeout_seconds": 900},
    "qa": {"agents": ["claude_sonnet", "codex_gpt5"], "prompt": ".orquestalite/packs/development/4/prompts/qa.md", "result_path": ".orquestalite/results/qa.json", "timeout_seconds": 1200},
    "adversary": {"agents": ["claude_opus", "codex_gpt5"], "prompt": ".orquestalite/packs/development/4/prompts/adversary.md", "result_path": ".orquestalite/results/adversary.json", "timeout_seconds": 1500},
    "critic": {"agents": ["claude_opus", "codex_gpt5"], "prompt": ".orquestalite/packs/development/4/prompts/critic.md", "result_path": ".orquestalite/results/critic.json", "timeout_seconds": 900},
    "integrator": {"agents": ["codex_gpt5", "claude_sonnet"], "prompt": ".orquestalite/packs/development/4/prompts/integrator.md", "result_path": ".orquestalite/results/integrator.json", "timeout_seconds": 1200},
    "gov_reviewer": {"agents": ["claude_opus", "codex_gpt5"], "prompt": ".orquestalite/packs/development/4/prompts/gov-reviewer.md", "result_path": ".orquestalite/results/gov_reviewer.json", "timeout_seconds": 1200},
    "batch_coder": {"agents": ["codex_gpt5", "claude_sonnet"], "prompt": ".orquestalite/packs/development/4/prompts/batch-coder.md", "result_path": ".orquestalite/results/batch_coder.json", "timeout_seconds": 2400},
    "intake": {"agents": ["claude_sonnet", "codex_gpt5"], "prompt": ".orquestalite/packs/development/4/prompts/intake.md", "result_path": ".orquestalite/results/intake.json", "timeout_seconds": 900},
    "pr_reviewer": {"agents": ["claude_opus", "codex_gpt5"], "prompt": ".orquestalite/packs/development/4/prompts/pr-reviewer.md", "result_path": ".orquestalite/results/pr_reviewer.json", "timeout_seconds": 1200}
  },
  "limits": {"resume_sessions": true},
  "rate_limit_backoff": {"initial_seconds": 30, "factor": 2, "max_seconds": 1800, "default_pattern": "(?i)(rate_?limit|429|quota|too many requests|session limit|usage limit)"},
  "runtime": {
    "retention_runs": 20,
    "artifact_max_bytes": 8388608,
    "provider_backoff": {"initial_seconds": 30, "factor": 2, "max_seconds": 1800, "default_pattern": "(?i)(rate_?limit|429|quota|too many requests|session limit|usage limit)"}
  },
  "conventions_file": "CONVENTIONS.md",
  "lint_argv": ["go", "vet", "./..."],
  "test_argv": ["go", "test", "./..."]
}
