{
  "agents": {
    "claude_opus": {
      "provider": "claude",
      "model": "claude-opus-5",
      "dangerously_skip_permissions": true,
      "rate_limit_pattern": "(?i)(rate[ _-]?limit|429|quota|too many requests|session limit|usage limit|spend limit|credit balance|overloaded)"
    },
    "claude_sonnet": {
      "provider": "claude",
      "model": "claude-sonnet-5",
      "dangerously_skip_permissions": true,
      "rate_limit_pattern": "(?i)(rate[ _-]?limit|429|quota|too many requests|session limit|usage limit|spend limit|credit balance|overloaded)"
    },
    "codex_sol": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "medium",
      "dangerously_skip_permissions": true,
      "rate_limit_pattern": "(?i)(rate[ _-]?limit|429|quota|too many requests|session limit|usage limit|spend limit|credit balance|rate_?limit_exceeded|overloaded)"
    },
    "codex_terra": {
      "provider": "codex",
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "dangerously_skip_permissions": true,
      "rate_limit_pattern": "(?i)(rate[ _-]?limit|429|quota|too many requests|session limit|usage limit|spend limit|credit balance|rate_?limit_exceeded|overloaded)"
    }
  },
  "roles": {
    "ticket_planner": {"agents": ["claude_opus", "codex_sol"], "prompt": ".orquestalite/packs/development/5/prompts/ticket-planner.md", "result_path": ".orquestalite/results/ticket_planner.json", "timeout_seconds": 900},
    "adversary": {"agents": ["claude_opus", "codex_sol"], "prompt": ".orquestalite/packs/development/5/prompts/adversary.md", "result_path": ".orquestalite/results/adversary.json", "timeout_seconds": 1800},
    "critic": {"agents": ["claude_opus", "codex_sol"], "prompt": ".orquestalite/packs/development/5/prompts/critic.md", "result_path": ".orquestalite/results/critic.json", "timeout_seconds": 1200},
    "gov_reviewer": {"agents": ["claude_opus", "codex_sol"], "prompt": ".orquestalite/packs/development/5/prompts/gov-reviewer.md", "result_path": ".orquestalite/results/gov_reviewer.json", "timeout_seconds": 1200},
    "intake": {"agents": ["claude_opus", "codex_sol"], "prompt": ".orquestalite/packs/development/5/prompts/intake.md", "result_path": ".orquestalite/results/intake.json", "timeout_seconds": 900},
    "pr_reviewer": {"agents": ["claude_opus", "codex_sol"], "prompt": ".orquestalite/packs/development/5/prompts/pr-reviewer.md", "result_path": ".orquestalite/results/pr_reviewer.json", "timeout_seconds": 1200},
    "qa": {"agents": ["claude_opus", "codex_sol"], "prompt": ".orquestalite/packs/development/5/prompts/qa.md", "result_path": ".orquestalite/results/qa.json", "timeout_seconds": 1800},

    "coder": {"agents": ["claude_sonnet", "codex_terra"], "prompt": ".orquestalite/packs/development/5/prompts/coder.md", "result_path": ".orquestalite/results/coder.json", "timeout_seconds": 1800},
    "batch_coder": {"agents": ["claude_sonnet", "codex_terra"], "prompt": ".orquestalite/packs/development/5/prompts/batch-coder.md", "result_path": ".orquestalite/results/batch_coder.json", "timeout_seconds": 2400},
    "integrator": {"agents": ["claude_sonnet", "codex_terra"], "prompt": ".orquestalite/packs/development/5/prompts/integrator.md", "result_path": ".orquestalite/results/integrator.json", "timeout_seconds": 1800},
    "ticket_qa": {"agents": ["claude_sonnet", "codex_terra"], "prompt": ".orquestalite/packs/development/5/prompts/ticket-qa.md", "result_path": ".orquestalite/results/ticket_qa.json", "timeout_seconds": 900},
    "visual_verifier": {"agents": ["claude_sonnet", "codex_terra"], "prompt": ".orquestalite/packs/development/5/prompts/visual-verifier.md", "result_path": ".orquestalite/results/visual_verifier.json", "timeout_seconds": 1200}
  },
  "limits": {"resume_sessions": true},
  "rate_limit_backoff": {"initial_seconds": 30, "factor": 2, "max_seconds": 1800, "default_pattern": "(?i)(rate[ _-]?limit|429|quota|too many requests|session limit|usage limit|spend limit|credit balance|overloaded)"},
  "runtime": {
    "retention_runs": 20,
    "artifact_max_bytes": 8388608,
    "provider_backoff": {"initial_seconds": 30, "factor": 2, "max_seconds": 1800, "default_pattern": "(?i)(rate[ _-]?limit|429|quota|too many requests|session limit|usage limit|spend limit|credit balance|overloaded)"},
    "context_optimization": {
      "compression_proxy": {"enabled": true, "url": "http://127.0.0.1:8787"},
      "command_filter": {"enabled": true, "binary": "rtk"}
    }
  },
  "conventions_file": "CONVENTIONS.md",
  "lint_argv": ["go", "vet", "./..."],
  "test_argv": ["go", "test", "./..."]
}
