{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TesterResult",
  "type": "object",
  "properties": {
    "status":      { "type": "string", "enum": ["pass", "fail"] },
    "command_run": { "type": "string" },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test":    { "type": "string" },
          "message": { "type": "string" },
          "hint":    { "type": "string" }
        },
        "required": ["test", "message"]
      }
    },
    "notes_for_memory": { "type": ["string", "null"] }
  },
  "required": ["status", "command_run", "failures"]
}
