{
  "apiVersion": "orq.dev/v2",
  "kind": "Flow",
  "metadata": {"name": "paperclip-coding", "version": "1"},
  "inputs": {"instructions": {"schema": "schema:text@1"}},
  "steps": [
    {
      "id": "implement",
      "uses": "activity:external.dispatch@1",
      "with": {
        "adapter": "paperclip",
        "employee": "coder",
        "instructions": {"$ref": "inputs.instructions"},
        "completionCondition": "Implement the ticket and publish the ticket-implementation result with evidence in the orq-result issue document.",
        "timeoutSeconds": 3600,
        "outputSchema": "schema:ticket-implementation@1",
        "outputMode": "deliverables",
        "completionGate": "item.deliverables.complete == true"
      }
    },
    {
      "id": "verify_completion",
      "uses": "activity:gate.assert@1",
      "with": {"value": {"$ref": "steps.implement.output.complete"}, "equals": true}
    }
  ],
  "outputs": {"implementation": {"$ref": "steps.implement.output"}}
}
