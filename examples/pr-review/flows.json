{
  "flows": {
    "pr_review": {
      "description": "Review an existing GitHub pull request with independent lenses (bug/quality via critic, security via security_auditor) plus deterministic test + lint gates, then a review_lead synthesizes a single verdict and posts it as a PR comment.",
      "inputs": {
        "pr_number": { "type": "string" },
        "base_branch": { "type": "string", "default": "main" },
        "test_command": { "type": "string", "default": "go test ./..." },
        "lint_command": { "type": "string", "default": "go vet ./..." }
      },
      "steps": [
        {
          "type": "command",
          "args": ["gh", "pr", "checkout", "{inputs.pr_number}"]
        },
        {
          "type": "command",
          "args": ["gh", "pr", "diff", "{inputs.pr_number}"],
          "outputs": { "pr_diff": "." }
        },
        {
          "type": "command",
          "command": "{inputs.test_command}",
          "on_failure": "continue",
          "outputs": { "test_res": "." }
        },
        {
          "type": "command",
          "command": "{inputs.lint_command}",
          "on_failure": "continue",
          "outputs": { "lint_res": "." }
        },
        {
          "type": "agent",
          "agent": "critic",
          "inputs": {
            "TASK_TITLE": "Review pull request #{inputs.pr_number}",
            "TASK_DESCRIPTION": "Review this pull request for logic bugs, regressions, missing edge cases and quality issues. You are checked out on the PR branch — use your git and file tools to inspect the changed files in context. The unified diff is included below.",
            "FILES_CHANGED": "{pr_diff.stdout}"
          },
          "outputs": { "critic_res": "." }
        },
        {
          "type": "agent",
          "agent": "security_auditor",
          "inputs": {
            "PR_NUMBER": "{inputs.pr_number}",
            "DIFF": "{pr_diff.stdout}"
          },
          "outputs": { "security_res": "." }
        },
        {
          "type": "agent",
          "agent": "review_lead",
          "inputs": {
            "PR_NUMBER": "{inputs.pr_number}",
            "DIFF": "{pr_diff.stdout}",
            "TESTS_PASS": "{test_res.pass}",
            "TEST_OUTPUT": "{test_res.stdout}",
            "LINT_PASS": "{lint_res.pass}",
            "LINT_OUTPUT": "{lint_res.stdout}",
            "CRITIC_APPROVED": "{critic_res.pass}",
            "CRITIC_CONCERNS": "{critic_res.concerns}",
            "SECURITY_APPROVED": "{security_res.pass}",
            "SECURITY_FINDINGS": "{security_res.findings}"
          },
          "outputs": { "review_res": "." }
        },
        {
          "type": "command",
          "args": ["gh", "pr", "comment", "{inputs.pr_number}", "--body", "{review_res.review_body}"],
          "on_failure": "continue"
        }
      ]
    }
  }
}
