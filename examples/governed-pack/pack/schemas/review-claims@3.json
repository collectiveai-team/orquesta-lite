{
  "x-orq-review-contract": 3,
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lens", "status", "summary", "findings", "limitations", "reviewed_revision", "evidence"],
  "properties": {
    "version": {"type": "integer", "enum": [3]},
    "lens": {"type": "string", "enum": ["structural", "risk", "resilience", "readability", "reliability"]},
    "status": {"type": "string", "enum": ["complete", "partial", "unavailable", "not_applicable"]},
    "summary": {"type": "string", "minLength": 1},
    "reviewed_revision": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "severity", "state", "location", "trigger", "impact", "proof_refs", "causal", "resolution"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "state": {"type": "string", "enum": ["open", "resolved", "refuted"]},
          "location": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "proof_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "causal": {"type": "string", "enum": ["introduced", "preexisting", "unknown"]},
          "resolution": {"type": "string"}
        }
      }
    },
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["requested", "executed", "required", "checked", "pending", "reason", "url", "artifacts"],
      "properties": {
        "requested": {"type": "string", "enum": ["browser", "static", "not_applicable"]},
        "executed": {"type": "string", "enum": ["browser", "static", "not_applicable", "unavailable"]},
        "required": {"type": "array", "items": {"type": "string"}},
        "checked": {"type": "array", "items": {"type": "string"}},
        "pending": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"},
        "url": {"type": "string"},
        "artifacts": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
