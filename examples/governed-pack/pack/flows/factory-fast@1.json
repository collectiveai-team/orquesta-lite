{
 "apiVersion": "orq.dev/v2",
 "kind": "Flow",
 "metadata": {
  "name": "factory-fast",
  "version": "1",
  "policy": "policy:development@3"
 },
 "inputs": {
  "features_path": {
   "schema": "schema:path@1",
   "default": "features.md"
  },
  "create_pr": {
   "schema": "schema:flag@1",
   "default": false
  }
 },
 "steps": [
  {
   "id": "plan_tickets",
   "uses": "activity:agent.invoke@1",
   "with": {
    "role": "ticket_planner",
    "outputSchema": "schema:workflow-state@2",
    "vars": {
     "MODE": "initial",
     "FEATURES_PATH": {
      "$ref": "inputs.features_path"
     },
     "CURRENT_STATE": "{}",
     "IMPLEMENTATION": "{}",
     "VERIFICATION": "{}",
     "APPEND": "false",
     "TRIAGE": ""
    }
   }
  },
  {
   "id": "fast_batch",
   "uses": "subflow:fast-batch@1",
   "with": {
    "features_path": {
     "$ref": "inputs.features_path"
    },
    "state": {
     "$ref": "steps.plan_tickets.output"
    }
   },
   "if": "steps.plan_tickets.output.status == \"active\" && steps.plan_tickets.output.next_ticket != null"
  },
  {
   "id": "plan_outcome",
   "uses": "activity:plan.outcome@1",
   "with": {
    "initial": {
     "$ref": "steps.plan_tickets.output"
    },
    "iterations": null,
    "fast": true,
    "batch": {
     "$ref": "steps.fast_batch.output"
    }
   }
  },
  {
   "id": "ticket_plan_complete",
   "uses": "activity:gate.assert@1",
   "if": "steps.plan_outcome.output.status != \"blocked\"",
   "with": {
    "value": {
     "$ref": "steps.plan_outcome.output.complete"
    },
    "equals": true,
    "message": "the batch ended with runnable work still incomplete"
   }
  },
  {
   "id": "push_branch",
   "uses": "activity:command.run@1",
   "with": {
    "argv": [
     "git",
     "push",
     "-u",
     "origin",
     "HEAD"
    ]
   },
   "if": "inputs.create_pr == true"
  },
  {
   "id": "publish_pr",
   "uses": "activity:command.run@1",
   "if": "inputs.create_pr == true && steps.plan_outcome.output.complete == true",
   "with": {
    "argv": [
     "sh",
     "-c",
     "gh pr create --fill --head \"$(git branch --show-current)\""
    ]
   }
  },
  {
   "id": "publish_draft_pr",
   "uses": "activity:command.run@1",
   "if": "inputs.create_pr == true && steps.plan_outcome.output.complete != true",
   "with": {
    "argv": [
     "sh",
     "-c",
     "gh pr create --fill --draft --head \"$(git branch --show-current)\""
    ]
   }
  }
 ],
 "outputs": {
  "plan": {
   "$ref": "steps.plan_tickets.output"
  },
  "batch": {
   "$ref": "steps.fast_batch.output"
  },
  "plan_outcome": {
   "$ref": "steps.plan_outcome.output"
  }
 }
}
