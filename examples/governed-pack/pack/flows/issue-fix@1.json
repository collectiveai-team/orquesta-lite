{
  "apiVersion": "orq.dev/v2",
  "kind": "Flow",
  "metadata": {
    "name": "issue-fix",
    "version": "1",
    "policy": "policy:development@3"
  },
  "inputs": {
    "issue_path": {
      "schema": "schema:path@1"
    },
    "run": {
      "schema": "schema:flag@1",
      "default": true
    },
    "strict_governance": {
      "schema": "schema:flag@1",
      "default": false
    }
  },
  "steps": [
    {
      "id": "read_issue",
      "uses": "activity:command.run@1",
      "with": {
        "argv": [
          "cat",
          {
            "$ref": "inputs.issue_path"
          }
        ]
      }
    },
    {
      "id": "triage",
      "uses": "activity:agent.invoke@1",
      "with": {
        "role": "intake",
        "context": {
          "ISSUE": {
            "$ref": "steps.read_issue.output.stdout"
          }
        },
        "outputSchema": "schema:intake-result@1",
        "fallbackOutput": {
          "actionable": false,
          "summary": "intake agent failed; fail closed",
          "plan": "",
          "missing_info": [
            "intake agent did not produce a verdict"
          ]
        }
      }
    },
    {
      "id": "plan_fix",
      "uses": "activity:agent.invoke@1",
      "if": "steps.triage.output.actionable == true && inputs.run == true",
      "with": {
        "role": "ticket_planner",
        "vars": {
          "MODE": "initial",
          "FEATURES_PATH": {
            "$ref": "inputs.issue_path"
          },
          "CURRENT_STATE": "{}",
          "IMPLEMENTATION": "{}",
          "VERIFICATION": "{}",
          "APPEND": "false"
        },
        "context": {
          "TRIAGE": {
            "$ref": "steps.triage.output"
          }
        },
        "outputSchema": "schema:workflow-state@2"
      }
    },
    {
      "id": "develop_tickets",
      "uses": "subflow:develop-ticket@1",
      "if": "steps.triage.output.actionable == true && inputs.run == true",
      "while": {
        "condition": "item.state.status == \"active\" && item.state.next_ticket != null",
        "maxIterations": {
          "$ref": "item.state.iteration_budget"
        },
        "initial": {
          "state": {
            "$ref": "steps.plan_fix.output"
          }
        }
      },
      "with": {
        "features_path": {
          "$ref": "inputs.issue_path"
        },
        "state": {
          "$ref": "item.state"
        },
        "commit_type": "fix"
      }
    },
    {
      "id": "plan_outcome",
      "uses": "activity:plan.outcome@1",
      "with": {
        "initial": {
          "$ref": "steps.plan_fix.output"
        },
        "iterations": {
          "$ref": "steps.develop_tickets.output"
        }
      },
      "if": "steps.triage.output.actionable == true && inputs.run == true"
    },
    {
      "id": "ticket_plan_complete",
      "uses": "activity:gate.assert@1",
      "if": "steps.triage.output.actionable == true && inputs.run == true && steps.plan_outcome.output.status != \"blocked\"",
      "with": {
        "value": {
          "$ref": "steps.plan_outcome.output.complete"
        },
        "equals": true,
        "message": "the ticket loop ended with runnable work still incomplete"
      }
    },
    {
      "id": "integrated_review",
      "uses": "subflow:integrated-review@1",
      "if": "steps.triage.output.actionable == true && inputs.run == true",
      "with": {
        "features_path": {
          "$ref": "inputs.issue_path"
        },
        "require_approval": {
          "$ref": "inputs.strict_governance"
        },
        "plan_outcome": {
          "$ref": "steps.plan_outcome.output"
        }
      }
    }
  ],
  "outputs": {
    "triage": {
      "$ref": "steps.triage.output"
    },
    "state": {
      "$ref": "steps.develop_tickets.output"
    },
    "governance": {
      "$ref": "steps.integrated_review.output"
    },
    "plan_outcome": {
      "$ref": "steps.plan_outcome.output"
    }
  }
}
