{
  "apiVersion": "orq.dev/v2",
  "kind": "Subflow",
  "metadata": {
    "name": "fast-batch",
    "version": "1"
  },
  "inputs": {
    "features_path": {
      "schema": "schema:path@1"
    },
    "state": {
      "schema": "schema:workflow-state@2"
    }
  },
  "steps": [
    {
      "id": "implement_batch",
      "uses": "activity:agent.invoke@1",
      "with": {
        "role": "batch_coder",
        "vars": {
          "FEATURES_PATH": {
            "$ref": "inputs.features_path"
          }
        },
        "context": {
          "WORKFLOW_STATE": {
            "$ref": "inputs.state"
          }
        },
        "outputSchema": "schema:ticket-implementation@1"
      },
      "if": "inputs.state.status == \"active\" && inputs.state.next_ticket != null"
    },
    {
      "id": "batch_lint",
      "uses": "activity:gate.run@1",
      "with": {
        "argv": {
          "$ref": "config.lint_argv"
        }
      },
      "if": "inputs.state.status == \"active\" && inputs.state.next_ticket != null"
    },
    {
      "id": "batch_tests",
      "uses": "activity:gate.run@1",
      "with": {
        "argv": {
          "$ref": "config.test_argv"
        }
      },
      "if": "inputs.state.status == \"active\" && inputs.state.next_ticket != null"
    },
    {
      "id": "batch_qa",
      "uses": "activity:agent.invoke@1",
      "with": {
        "role": "qa",
        "vars": {
          "FEATURES_PATH": {
            "$ref": "inputs.features_path"
          }
        },
        "outputSchema": "schema:review-result@2",
        "fallbackOutput": {
          "version": 2,
          "status": "unavailable",
          "decision": "inconclusive",
          "approved": false,
          "summary": "Required reviewer unavailable",
          "findings": [],
          "limitations": [
            "Provider did not produce a valid review checkpoint"
          ],
          "reviewed_revision": "",
          "evidence": []
        }
      },
      "if": "inputs.state.status == \"active\" && inputs.state.next_ticket != null"
    },
    {
      "id": "batch_review_evidence",
      "uses": "activity:review.aggregate@1",
      "with": {
        "reviews": [
          {
            "$ref": "steps.batch_qa.output"
          }
        ]
      },
      "if": "inputs.state.status == \"active\" && inputs.state.next_ticket != null"
    },
    {
      "id": "batch_review_coverage",
      "uses": "activity:gate.assert@1",
      "with": {
        "value": {
          "$ref": "steps.batch_review_evidence.output.ready"
        },
        "equals": true,
        "message": "Batch QA incomplete; obtain review evidence before repair"
      },
      "if": "inputs.state.status == \"active\" && inputs.state.next_ticket != null"
    },
    {
      "id": "batch_repair",
      "uses": "activity:agent.invoke@1",
      "if": "inputs.state.status == \"active\" && inputs.state.next_ticket != null && (steps.batch_review_evidence.output.needs_repair == true)",
      "while": {
        "condition": "item.continue == true",
        "maxIterations": 3,
        "initial": {
          "continue": true,
          "summary": "resolve batch QA findings",
          "remaining": [
            "review batch QA findings"
          ]
        }
      },
      "with": {
        "role": "integrator",
        "vars": {
          "FEATURES_PATH": {
            "$ref": "inputs.features_path"
          }
        },
        "context": {
          "QA_REVIEW": {
            "$ref": "steps.batch_qa.output"
          },
          "CONFIRMED_FINDINGS": {
            "$ref": "steps.batch_review_evidence.output.repair_findings"
          },
          "CRITIC_REVIEW": "",
          "FEEDBACK": {
            "$ref": "item"
          },
          "ITERATION": {
            "$ref": "index"
          }
        },
        "outputSchema": "schema:iteration-result@1",
        "fallbackOutput": {
          "continue": false,
          "summary": "integrator agent failed; stopping repair loop",
          "remaining": [
            "integrator did not report"
          ]
        }
      }
    },
    {
      "id": "final_lint",
      "uses": "activity:gate.run@1",
      "with": {
        "argv": {
          "$ref": "config.lint_argv"
        }
      },
      "if": "inputs.state.status == \"active\" && inputs.state.next_ticket != null"
    },
    {
      "id": "final_tests",
      "uses": "activity:gate.run@1",
      "with": {
        "argv": {
          "$ref": "config.test_argv"
        }
      },
      "if": "inputs.state.status == \"active\" && inputs.state.next_ticket != null"
    },
    {
      "id": "final_batch_qa",
      "uses": "activity:agent.invoke@1",
      "if": "inputs.state.status == \"active\" && inputs.state.next_ticket != null && steps.batch_qa.output.approved != true",
      "with": {
        "role": "qa",
        "vars": {
          "FEATURES_PATH": {
            "$ref": "inputs.features_path"
          }
        },
        "context": {
          "QA_REVIEW": {
            "$ref": "steps.batch_qa.output"
          },
          "IMPLEMENTATION": {
            "$ref": "steps.implement_batch.output"
          },
          "WORKFLOW_STATE": {
            "$ref": "inputs.state"
          },
          "ADVERSARY_REVIEW": "",
          "CRITIC_REVIEW": "",
          "VISUAL_REVIEW": ""
        },
        "outputSchema": "schema:review-result@2",
        "fallbackOutput": {
          "version": 2,
          "status": "unavailable",
          "decision": "inconclusive",
          "approved": false,
          "summary": "Post-repair batch reviewer unavailable",
          "findings": [],
          "limitations": [
            "The repaired batch did not receive a valid independent QA checkpoint"
          ],
          "reviewed_revision": "",
          "evidence": []
        }
      }
    }
  ],
  "outputs": {
    "implementation": {
      "$ref": "steps.implement_batch.output"
    },
    "qa": {
      "$ref": "steps.batch_qa.output"
    },
    "final_qa": {
      "$ref": "steps.final_batch_qa.output"
    }
  }
}
