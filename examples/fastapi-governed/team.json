{
  "agents": {
    "claude_haiku": {
      "provider": "claude",
      "model": "claude-haiku-4-5-20251001",
      "dangerously_skip_permissions": true,
      "rate_limit_pattern": "(?i)(rate_?limit|429|quota|session limit|usage limit)"
    }
  },
  "roles": {
    "parser": {
      "agents": ["claude_haiku"],
      "prompt": "prompts/parser.md",
      "result_path": ".orquestalite/results/parser.json",
      "timeout_seconds": 600,
      "decompose_prompt": "prompts/parser-decompose.md"
    },
    "coder": {
      "agents": ["claude_haiku"],
      "prompt": "prompts/coder.md",
      "result_path": ".orquestalite/results/coder.json",
      "timeout_seconds": 1800
    },
    "tester": {
      "agents": ["claude_haiku"],
      "prompt": "prompts/tester.md",
      "result_path": ".orquestalite/results/tester.json",
      "timeout_seconds": 900
    },
    "critic": {
      "agents": ["claude_haiku"],
      "prompt": "prompts/critic.md",
      "result_path": ".orquestalite/results/critic.json",
      "timeout_seconds": 600
    },
    "reviewer": {
      "agents": ["claude_haiku"],
      "prompt": "prompts/reviewer.md",
      "result_path": ".orquestalite/results/reviewer.json",
      "timeout_seconds": 900
    },
    "architect": {
      "agents": ["claude_haiku"],
      "prompt": "prompts/architect.md",
      "result_path": ".orquestalite/results/architect.json",
      "timeout_seconds": 900
    },
    "qa": {
      "agents": ["claude_haiku"],
      "prompt": "prompts/qa.md",
      "result_path": ".orquestalite/results/qa.json",
      "timeout_seconds": 900
    },
    "pm": {
      "agents": ["claude_haiku"],
      "prompt": "prompts/pm.md",
      "result_path": ".orquestalite/results/pm.json",
      "timeout_seconds": 600
    }
  },
  "limits": {
    "max_review_cycles": 3,
    "max_fix_iterations": 3
  },
  "rate_limit_backoff": {
    "initial_seconds": 20,
    "factor": 2,
    "max_seconds": 600,
    "default_pattern": "(?i)(rate_?limit|429|quota|too many requests|session limit|usage limit)"
  },
  "full_test_command": "uv run pytest -q",
  "lint_command": "uv run ruff check ."
}
