# binaries
/orq-lite
/dist/

# runtime state (orchestrator writes here)
/.orquestalite/

# go
bin/
*.test
*.out
coverage.txt

# OS/editor
.DS_Store
*.swp
*.swo

# local planning docs (not committed)
plan*.md
.orquestalite/
team.json
prompts/
schemas/
flows.json

# examples ship complete, runnable configs — the repo-wide team.json / prompts/
# ignores above must not swallow the bundled example configs and role prompts
!examples/**/team.json
!examples/**/prompts/
!examples/**/prompts/**
!examples/**/flows.json
!examples/**/plan.md

# the embedded assets that `orq-lite init` scaffolds from are part of the binary,
# not runtime-generated dogfooding config — keep them trackable despite the
# repo-wide prompts/, schemas/, and flows.json ignores.
!internal/commands/assets/prompts/
!internal/commands/assets/prompts/**
!internal/commands/assets/flows.json

# versioned benchmark packs are source fixtures, not generated workspace state
!benchmark/packs/
!benchmark/packs/**

# Benchmark: heavy run artifacts (bundles, dbs, logs) and personal post drafts
benchmark/results/*-artifacts/
benchmark/posts/
__pycache__/
