{
  "agents": {
    "claude_opus": {
      "provider": "claude",
      "model": "claude-opus-4-8",
      "dangerously_skip_permissions": true,
      "safe_mode": true,
      "rate_limit_pattern": "(?i)(rate_?limit|429|quota|session limit|usage limit)"
    },
    "claude_sonnet": {
      "provider": "claude",
      "model": "claude-sonnet-4-6",
      "dangerously_skip_permissions": true,
      "safe_mode": true,
      "rate_limit_pattern": "(?i)(rate_?limit|429|quota|session limit|usage limit)"
    },
    "qwen_coder": {
      "provider": "opencode",
      "model": "opencode-go/qwen3.6-plus",
      "dangerously_skip_permissions": true,
      "rate_limit_pattern": "(?i)(rate_?limit|429|quota|too many requests)"
    }
  },
  "roles": {
    "parser": {
      "agents": [
        "claude_opus"
      ],
      "prompt": "prompts/parser.md",
      "result_path": ".orquestalite/results/parser.json",
      "timeout_seconds": 600,
      "decompose_prompt": "prompts/parser-decompose.md"
    },
    "coder": {
      "agents": [
        "qwen_coder"
      ],
      "prompt": "prompts/coder.md",
      "result_path": ".orquestalite/results/coder.json",
      "timeout_seconds": 1800
    },
    "tester": {
      "agents": [
        "qwen_coder"
      ],
      "prompt": "prompts/tester.md",
      "result_path": ".orquestalite/results/tester.json",
      "timeout_seconds": 900
    },
    "critic": {
      "agents": [
        "claude_sonnet"
      ],
      "prompt": "prompts/critic.md",
      "result_path": ".orquestalite/results/critic.json",
      "timeout_seconds": 600
    },
    "reviewer": {
      "agents": [
        "claude_opus"
      ],
      "prompt": "prompts/reviewer.md",
      "result_path": ".orquestalite/results/reviewer.json",
      "timeout_seconds": 900
    },
    "architect": {
      "agents": [
        "claude_opus"
      ],
      "prompt": "prompts/architect.md",
      "result_path": ".orquestalite/results/architect.json",
      "timeout_seconds": 900
    },
    "qa": {
      "agents": [
        "claude_opus"
      ],
      "prompt": "prompts/qa.md",
      "result_path": ".orquestalite/results/qa.json",
      "timeout_seconds": 900
    },
    "pm": {
      "agents": [
        "claude_opus"
      ],
      "prompt": "prompts/pm.md",
      "result_path": ".orquestalite/results/pm.json",
      "timeout_seconds": 600
    },
    "gov_reviewer": {
      "agents": [
        "claude_opus"
      ],
      "prompt": "prompts/gov-reviewer.md",
      "result_path": ".orquestalite/results/gov_reviewer.json",
      "timeout_seconds": 1200
    }
  },
  "limits": {
    "max_review_cycles": 3,
    "max_fix_iterations": 5,
    "verify_tester_command": true
  },
  "rate_limit_backoff": {
    "initial_seconds": 30,
    "factor": 2,
    "max_seconds": 1800,
    "default_pattern": "(?i)(rate_?limit|429|quota|too many requests|session limit|usage limit)"
  },
  "conventions_file": "CONVENTIONS.md",
  "full_test_command": "uv run pytest -q",
  "lint_command": "uv run ruff check ."
}
